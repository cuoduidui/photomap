# 统一使用 LF 换行符，避免 Windows 下 CRLF 造成的无意义全量 diff
* text=auto eol=lf

# 源码与文本按文本处理（自动归一化为 LF）
*.rs text
*.toml text
*.json text
*.md text
*.html text
*.css text
*.js text
*.ts text
*.vue text
*.yml text
*.yaml text

# 二进制资源不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.db-shm binary
*.db-wal binary
