{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "PhotoMap",
  "version": "1.0.0",
  "identifier": "com.cuoduidui.photomap",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English", "Japanese", "French", "Korean", "German", "Russian"],
        "displayLanguageSelector": false
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "PhotoMap",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://webapi.amap.com; style-src 'self' 'unsafe-inline' https://webapi.amap.com; img-src 'self' data: blob: https:; connect-src 'self' https: blob: ws: ipc: http://ipc.localhost; media-src 'self' data: blob:; font-src 'self' data:;"
    }
  },
  "plugins": {}
}
